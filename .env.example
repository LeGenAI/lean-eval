# Mac Studio LM Studio server shared on the lab network.
EVAL_PANEL=local
LM_STUDIO_BASE_URL=http://192.168.0.43:1234/v1

# Fixed model identifiers exposed by LM Studio.
EVAL_GOEDEL_V2_SLUG=goedel-prover-v2-8b
EVAL_BFS_PROVER_SLUG=bytedance-seed.bfs-prover-v2-7b

# Default evaluator settings used in the workshop runs.
LEAN_VERIFIER=repl
LEAN_REPL_POOL_SIZE=1
GOEDEL_PROMPT_STYLE=goedel_v1
GOEDEL_MAX_TOKENS=3072
GOEDEL_TEMPERATURE=1.0
BFS_TEMPERATURE=0.7
BFS_MAX_TOKENS=256
